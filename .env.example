NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# PostgreSQL 16 (India Mumbai in prod, Docker locally)
DATABASE_URL="postgresql://skybook:skybook_dev_pass@localhost:5432/skybook?schema=public"

# Redis 7
REDIS_URL="redis://localhost:6379"

# Auth & JWT
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-skybook-2026"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-skybook-2026"
COOKIE_SECRET="change-me-cookie-secret-min-32-chars-skybook-2026"

# Field-Level PII Encryption (32-byte hex = 64 hex chars for AES-256-GCM)
PII_ENCRYPTION_KEY_HEX="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Ed25519 QR Ticket Signing Keys (Base64 DER SPKI / PKCS8 - auto-generated in dev if blank)
TICKET_ED25519_PRIVATE_KEY_B64=""
TICKET_ED25519_PUBLIC_KEY_B64=""

# Integrations & Viva Fallbacks (AS-02, AS-03, EI-04)
MOCK_OTP=true
MOCK_PAYMENT=true
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_test_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"

# CORS Origins
PASSENGER_ORIGIN="http://localhost:3000"
ADMIN_ORIGIN="http://localhost:3001"